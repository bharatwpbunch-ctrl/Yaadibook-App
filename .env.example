# Yaadibook Environment Configuration Example
# Copy this to .env (do not commit .env to version control)
# Provide values at build or runtime via --dart-define or CI/CD pipelines.

# Application Environment: dev | staging | prod
APP_ENV=dev

# Safe Client-Side Values (Public Anon Key and Project URL for Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-safe-client-anon-key

# NOTE: NEVER put SUPABASE_SERVICE_ROLE_KEY or database root credentials in this file or anywhere in the Flutter app.
# Service-role keys bypass Row Level Security (RLS) and must strictly reside in server-side functions or secure backend environments.

